{
  "name": "traffic-flow-simulator",
  "version": "1.0.0",
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "concurrently": "^10.0.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1"
  },
  "private": true,
  "scripts": {
    "dev:backend": "cd backend && uv run fastapi dev src/main.py",
    "dev:frontend": "cd frontend && bun run dev",
    "dev": "concurrently \"bun run dev:frontend\" \"bun run dev:backend\"",
    "pre-commit": "lint-staged",
    "prepare": "husky"
  },
  "type": "module"
}
