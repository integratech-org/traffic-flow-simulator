@@ -0,0 +1,35 @@
+import { useEffect, useRef } from "react"
+import { WS_URL, type TickMessage, type VehicleType } from "@/api/simulation"
+import { useSimStore } from "../store"
+
+/** Opens /simulation/runs/{id}/stream while a run exists and feeds the store. */
+export function useTickStream(vehicleType: VehicleType | null = null) {
+  const runId = useSimStore((s) => s.runId)
+  const pushTick = useSimStore((s) => s.pushTick)
+  const wsRef = useRef<WebSocket | null>(null)
+  const filterRef = useRef(vehicleType)
+
+  useEffect(() => {
+    if (!runId) return
+    const q = filterRef.current ? `?vehicle_type=${filterRef.current}` : ""
+    const ws = new WebSocket(`${WS_URL}/simulation/runs/${runId}/stream${q}`)
+    wsRef.current = ws
+    ws.onmessage = (e) => {
+      const msg = JSON.parse(e.data as string)
+      if (!("error" in msg)) pushTick(msg as TickMessage)
+    }
+    return () => {
+      ws.close()
+      wsRef.current = null
+    }
+  }, [runId, pushTick])
+
+  // 2W/4W toggle: backend lets us switch the filter without reconnecting
+  useEffect(() => {
+    filterRef.current = vehicleType
+    const ws = wsRef.current
+    if (ws?.readyState === WebSocket.OPEN) {
+      ws.send(JSON.stringify({ vehicle_type: vehicleType }))
+    }
+  }, [vehicleType])
+}
diff --git a/b/frontend/src/features/simulation/store.ts b/frontend/src/features/simulation/store.ts
new file mode 100644
index 0000000..5d13c90
--- /dev/null
+++ b/frontend/src/features/simulation/store.ts
@@ -0,0 +1,79 @@
+import { create } from "zustand"
+import type { CreateRunRequest, RunState, TickMessage } from "@/api/simulation"
+
+export const DEFAULT_CONFIG: CreateRunRequest = {
+  day_of_week: "monday",
+  time: "08:00",
+  weather_condition: "clear",
+  density_scenario: "light",
+  vehicle_mix: { two_wheeler_pct: 40, four_wheeler_pct: 60 },
+  vehicle_params: {
+    car: { v_max: 15, v_min: 0, p_slow: 0.2 },
+    motorcycle: { v_max: 20, v_min: 0, p_slow: 0.1 },
+  },
+  signal_plan: {
+    signal_timers: [1, 2, 3, 4].map((i) => ({
+      signal_id: `S${i}`,
+      green: 30,
+      yellow: 5,
+      red: 30,
+    })),
+  },
+  seed: null,
+}
+
+export interface QueuePoint {
+  t: number // simulated seconds
+  queue: number // vehicles currently stopped
+}
+
+interface SimStore {
+  // what the dialogs edit; sent as the body of POST /simulation/runs
+  config: CreateRunRequest
+  patchConfig: (patch: Partial<CreateRunRequest>) => void
+
+  // live run state
+  runId: string | null
+  status: "idle" | RunState
+  tick: TickMessage | null
+  queueHistory: QueuePoint[]
+
+  setRun: (runId: string) => void
+  setStatus: (status: "idle" | RunState) => void
+  pushTick: (tick: TickMessage) => void
+  clearRun: () => void
+}
+
+export const useSimStore = create<SimStore>((set) => ({
+  config: DEFAULT_CONFIG,
+  patchConfig: (patch) => set((s) => ({ config: { ...s.config, ...patch } })),
+
+  runId: null,
+  status: "idle",
+  tick: null,
+  queueHistory: [],
+
+  setRun: (runId) =>
+    set({ runId, status: "created", tick: null, queueHistory: [] }),
+  setStatus: (status) => set({ status }),
+  pushTick: (tick) =>
+    set((s) => {
+      const last = s.queueHistory.at(-1)
+      const sample = tick.tick % 5 === 0 && last?.t !== tick.tick
+      return {
+        tick,
+        status: tick.state,
+        queueHistory: sample
+          ? [
+              ...s.queueHistory,
+              {
+                t: tick.tick,
+                queue: tick.vehicles.filter((v) => v.speed === 0).length,
+              },
+            ].slice(-120)
+          : s.queueHistory,
+      }
+    }),
+  clearRun: () =>
+    set({ runId: null, status: "idle", tick: null, queueHistory: [] }),
+}))
